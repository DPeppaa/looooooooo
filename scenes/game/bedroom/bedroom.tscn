[sub_resource type="GDScript" id="GDScript_q26l1"]
script/source = "extends Area3D

@onready var bed_collision: CollisionShape3D = $bed_static/bed_collision

func _ready() -> void:
	bed_collision.disabled = true
	
	
func _on_body_exited(body: Node3D) -> void:
	if body is player_controller:
		bed_collision.disabled = false
"

